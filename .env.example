# Copiá este archivo a .env.local y completá con las credenciales de tu
# proyecto de Supabase (Dashboard -> Project Settings -> API / Database).
# NUNCA subas .env.local al repo.

# --- Cliente (browser + servidor). Seguras de exponer. ---
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# --- Solo servidor. SECRETA: nunca la expongas al browser. ---
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# --- Solo para la CLI de migraciones (npm run db:push / db:diff). ---
# Dashboard -> Project Settings -> Database -> Connection string (URI).
SUPABASE_DB_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres
